---
export const prerender = false;
import AppLayout from '../layouts/AppLayout';

// Las importas desde assets usando la ruta correspondiente
import macBackground1 from '../assets/images/mac-background1.jpg';
import macBackground2 from '../assets/images/mac-background2.jpg';
import macBackground3 from '../assets/images/mac-background3.jpg';

// Extraemos la propiedad .src de cada una
const backgroundMap = {
  'bg-1': macBackground1.src,
  'bg-2': macBackground2.src,
  'bg-3': macBackground3.src
};

function getRandomBackground() {
  const keys = Object.keys(backgroundMap);
  return keys[Math.floor(Math.random() * keys.length)];
}
---

<AppLayout
  client:load
  initialBg={getRandomBackground()}
  backgroundMap={backgroundMap}
/>