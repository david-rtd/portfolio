---
export const prerender = false;
import AppLayout from '../layouts/AppLayout';

// Declaramos el objeto con las rutas de la carpeta public
const backgroundMap = {
  'bg-1': '/images/mac-background1.jpg',
  'bg-2': '/images/mac-background2.jpg',
  'bg-3': '/images/mac-background3.jpg'
};

// Función para elegir un fondo aleatorio
function getRandomBackground() {
  const keys = Object.keys(backgroundMap);
  return keys[Math.floor(Math.random() * keys.length)];
}
---

<AppLayout
  client:load
  initialBg={getRandomBackground()}
  backgroundMap={backgroundMap}
/>